# ==============================================================================
# AI Incident Monitor — Local Environment Configuration Template
# Copy this file to '.env' to configure your local environment:
#   cp .env.example .env
#
# CRITICAL SECURITY NOTICE (Constitutional Rules 9 & 15):
# NEVER commit your actual '.env' file or paste secret API keys in chat or git.
# The '.env' file is strictly git-ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Intelligence Configuration (Incident Explanations & Defense Guidance)
# ------------------------------------------------------------------------------
# Primary Provider: 'claude' (Anthropic Claude), 'gemini' (Google Gemini Pro),
# or 'mock' (Deterministic offline local testing)
AI_MONITOR_LLM_PROVIDER=claude

# ------------------------------------------------------------------------------
# Anthropic Claude Configuration (Primary)
# ------------------------------------------------------------------------------
# Your Anthropic API Key (sk-ant-api03-...)
ANTHROPIC_API_KEY=

# Optional Anthropic Workspace ID (wrk_...) required if your API key was created at the Organization level
# ANTHROPIC_WORKSPACE_ID=

# Supported cost-conscious Sonnet model (default: claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ------------------------------------------------------------------------------
# Google Gemini Pro Configuration (Alternative)
# ------------------------------------------------------------------------------
# Your Google AI Studio or Google Cloud Gemini API Key
GEMINI_API_KEY=

# Supported Gemini Pro model (default: gemini-2.5-pro, stable)
GEMINI_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# Enforceable Pilot Budget Cap (USD)
# ------------------------------------------------------------------------------
# The application will halt inference before dispatch if remaining budget is exceeded
AI_MONITOR_MAX_PILOT_BUDGET_USD=1.00

# ------------------------------------------------------------------------------
# Storage & Database Overrides (Optional - defaults to .data/dev.db)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:////Volumes/SanDiskOne/AI Projects/AIG-AI-Incident-Monitor/AIG-AI-Incident-Monitor/.data/dev.db

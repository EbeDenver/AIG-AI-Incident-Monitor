# ==============================================================================
# AI Incident Monitor — Local Environment Configuration Template
# Copy this file to '.env' to configure your local environment:
#   cp .env.example .env
#
# CRITICAL SECURITY NOTICE (Constitutional Rules 9 & 15):
# NEVER commit your actual '.env' file or paste secret API keys in chat or git.
# The '.env' file is strictly git-ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Intelligence Configuration (Incident Explanations & Defense Guidance)
# ------------------------------------------------------------------------------
# Provider: 'gemini' for Google Gemini API, or 'mock' for local offline testing
AI_MONITOR_LLM_PROVIDER=gemini

# Model ID: Recommended 'gemini-2.5-pro' for structured reasoning and synthesis
# Alternative: 'gemini-2.5-flash' for high-volume low-cost testing
AI_MONITOR_LLM_MODEL=gemini-2.5-pro

# Your Google AI Studio or Google Cloud Gemini API Key
AI_MONITOR_LLM_API_KEY=your_api_key_here

# Enforceable Application Spending Limit Ceiling (in USD)
# The application will immediately halt inference if cumulative cost reaches this cap
AI_MONITOR_MAX_PILOT_BUDGET_USD=1.00

# ------------------------------------------------------------------------------
# Storage & Database Overrides (Optional - defaults to .data/dev.db)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:////Volumes/SanDiskOne/AI Projects/AIG-AI-Incident-Monitor/AIG-AI-Incident-Monitor/.data/dev.db
